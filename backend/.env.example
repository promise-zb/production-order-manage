# 复制成 .env 后按需要修改。不复制也能跑，默认用本机 SQLite，账号 admin / admin。
# 启动：在仓库根目录执行 pnpm dev，或在本目录执行 npm start。

# 监听端口
PORT=8080

# 留空：使用本机 SQLite 文件 data/orders.db
# 填写：使用 Deno Deploy 上的 PostgreSQL，必须是 postgresql:// 开头
DATABASE_URL=

# SQLite 文件位置，只有没填 DATABASE_URL 时才用到
DB_PATH=data/orders.db

# 登录账号。正式使用前请改掉
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# 给登录令牌签名的密钥。正式使用前请改成一长串随机字符
AUTH_SECRET=dev-only-change-me

# 空表时是否写入几条示例订单。填 0 表示不写
SEED=1
