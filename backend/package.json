  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-path=server.ts --watch-path=db.ts --watch-path=auth.ts --watch-path=orders.ts --watch-path=excel.ts --watch-path=types.ts --disable-warning=ExperimentalWarning server.ts",
    "start": "node --disable-warning=ExperimentalWarning server.ts",
